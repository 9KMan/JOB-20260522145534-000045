# DOMO API Configuration
# Copy this file to .env and fill in your actual values

# DOMO Instance hostname (e.g., 'your-company.domo.com')
DOMO_INSTANCE=your-instance.domo.com

# DOMO API Token (for token-based authentication)
# Generate at: DOMO Settings > API > Generate Token
DOMO_TOKEN=your-token

# DOMO OAuth Credentials (for OAuth authentication)
# Generate at: DOMO Settings > API > Create New Client
DOMO_CLIENT_ID=your-client-id
DOMO_CLIENT_SECRET=your-client-secret

# ===========================================
# AUTHENTICATION NOTES
# ===========================================
# You can use either:
# 1. Token-based auth: Set DOMO_TOKEN only
# 2. OAuth auth: Set DOMO_CLIENT_ID and DOMO_CLIENT_SECRET
#
# Token-based is simpler for scripts and automation.
# OAuth is better for production applications.
# ===========================================
